NODE_ENV=development
APP_URL=http://localhost:3000

# Banco novo do CRM360. Nunca reutilize os valores do projeto PHP antigo.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm360_webapp
DB_USER=crm360_webapp
DB_PASSWORD=gere-uma-senha-forte-fora-do-repositorio
DB_SSL=false

# Gere com: openssl rand -base64 32
SESSION_SECRET=gere-um-segredo-aleatorio-de-no-minimo-32-bytes
APP_ENCRYPTION_KEY=gere-uma-chave-base64-de-32-bytes

# Evolution API já existente
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=configure-no-painel-da-hostinger

# Cloudflare Turnstile (a chave de site é pública; a secreta jamais deve ir ao navegador)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP para verificação de e-mail e recuperação de senha
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=465
SMTP_USER=suporte@360bh.com.br
SMTP_PASSWORD=
SMTP_SECURE=true

# Opcional para mídias privadas. Não usar URLs públicas permanentes.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
